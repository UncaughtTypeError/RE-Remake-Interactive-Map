{
    "name": "@re-remake/mcp-server",
    "version": "1.0.0",
    "description": "Model Context Protocol server for RE Remake Interactive Map API",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "resident-evil",
        "api"
    ],
    "author": "Nathan Shepherd",
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^0.5.0",
        "node-fetch": "^3.3.2"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
