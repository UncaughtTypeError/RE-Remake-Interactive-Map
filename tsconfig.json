{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "allowSyntheticDefaultImports": true,
        "outDir": "./dist",
        "rootDir": "./",
        "moduleResolution": "bundler",
        "resolvePackageJsonExports": true,
        "resolvePackageJsonImports": true,
        "paths": {
            "src/*": ["./src/*"],
            "client/*": ["./src/client/*"],
            "safeRoomAudioPlayer/*": ["./src/ui/safeRoomAudioPlayer/*"],
            "themeSelect/*": ["./src/ui/themeSelect/*"],
            "difficultySelect/*": ["./src/ui/difficultySelect/*"],
            "roomDetail/*": ["./src/ui/roomDetail/*"],
            "roomSummary/*": ["./src/ui/roomSummary/*"],
            "introOverlay/*": ["./src/ui/introOverlay/*"],
            "keymenu/*": ["./src/ui/keymenu/*"],
            "shared/*": ["./src/ui/shared/*"]
        },
        "types": ["jest", "node", "express"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "src/__tests__", "dist"]
}
